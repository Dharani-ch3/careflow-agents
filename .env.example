# Copy to .env and fill in what you need. Every setting has a sensible default,
# so an empty .env runs the whole project offline.

# Which model drives the agents: offline | openai | anthropic | ollama
# "offline" uses the deterministic rule-based fallbacks - no key, no cost.
CAREFLOW_LLM_PROVIDER=offline

# Defaults: gpt-4o-mini (openai), llama3.1 (ollama). Required for anthropic: set it to a model id.
# CAREFLOW_LLM_MODEL=

# Provider keys are read by the provider SDKs directly.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CAREFLOW_OLLAMA_BASE_URL=http://localhost:11434

# Where the demo data lives.
# CAREFLOW_DATA_DIR=data

# Requests the agents are less sure about than this go to a human.
# CAREFLOW_CONFIDENCE_THRESHOLD=0.75

# How many times the verifier may send work back before a human takes over.
# CAREFLOW_MAX_ATTEMPTS=2

# If set, POST /reviews/* requires the header  X-Reviewer-Key: <value>
# CAREFLOW_REVIEWER_API_KEY=

# If set (any passphrase), checkpoints are encrypted at rest with AES.
# Needs:  pip install "careflow-agents[encryption]"
# CAREFLOW_CHECKPOINT_KEY=

# How the agents reach the tool server: inprocess | stdio
# CAREFLOW_MCP_TRANSPORT=inprocess
